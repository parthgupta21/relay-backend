NODE_ENV=production
PORT=3000
TRUST_PROXY=true
LOG_FORMAT=json
METRICS_PORT=9100
APP_BASE_URL=https://app.example.com
HOOKS_BASE_URL=https://hooks.example.com

DB_HOST=mysql
DB_PORT=3306
DB_NAME=relay
DB_USERNAME=relay
DB_PASSWORD=
DB_POOL_MAX=10

REDIS_URL=redis://redis:6379

# generate with: openssl rand -base64 32
RELAY_ENCRYPTION_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RELAY <no-reply@example.com>

PLAN_DEFAULTS={"maxEndpoints":5,"maxDestinations":3,"maxEventsPerDay":5000,"maxEventsPerMonth":100000,"maxBodyBytes":524288,"retentionDays":3}
AUTH_RATE_PER_MINUTE=10
ACCOUNT_DELETE_RATE_PER_MINUTE=5
INGEST_RATE_PER_MINUTE=600
DELIVERY_CONCURRENCY=50
